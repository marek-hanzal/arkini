{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"~scripts/*": [
				"./scripts/*"
			],
			"~/*": [
				"./src/*"
			],
			"~electron/*": [
				"./electron/*"
			],
			"~shared/*": [
				"./shared/*"
			],
			"~test/*": [
				"./test/*"
			]
		}
	},
	"include": [
		"electron/contract",
		"src",
		"test",
		"vitest.config.ts"
	]
}
