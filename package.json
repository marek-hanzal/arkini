{
	"name": "arkini",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@12.0.2",
	"allowScripts": {
		"@modelcontextprotocol/inspector@2.3.0": true,
		"electron-winstaller": true,
		"esbuild": true,
		"msgpackr-extract@3.0.4": true
	},
	"scripts": {
		"postinstall": "install-electron",
		"cache:llm": "bash scripts/build-llm-npm-cache.sh",
		"arkini": "tsx cli/arkini.ts",
		"arkpack:keygen": "tsx cli/arkini.ts arkpack keygen",
		"arkpack:sign": "tsx cli/arkini.ts arkpack sign",
		"arkpack:verify": "tsx cli/arkini.ts arkpack verify",
		"predev": "npm run game:pack:official && npm run game:pack:demo",
		"dev": "run-p dev:app mcp:inspect",
		"dev:app": "electron-vite dev",
		"predev:control": "npm run predev",
		"dev:control": "run-p dev:control:app mcp:inspect",
		"dev:control:app": "ARKINI_DEV_CONTROL=1 electron-vite dev",
		"mcp:inspect": "mcp-inspector --web --server-url http://127.0.0.1:32310/editor/mcp --transport http",
		"build": "tsx cli/arkini.ts desktop build",
		"preview": "electron-vite preview",
		"preview:macos": "tsx cli/arkini.ts desktop preview-macos",
		"typecheck:src": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit --noUnusedLocals --noUnusedParameters",
		"typecheck:electron": "tsc -p tsconfig.electron.json --noEmit --noUnusedLocals --noUnusedParameters",
		"typecheck": "run-p typecheck:*",
		"test": "vitest run --no-color",
		"test:shard:1": "vitest run --no-color --shard=1/10",
		"test:shard:2": "vitest run --no-color --shard=2/10",
		"test:shard:3": "vitest run --no-color --shard=3/10",
		"test:shard:4": "vitest run --no-color --shard=4/10",
		"test:shard:5": "vitest run --no-color --shard=5/10",
		"test:shard:6": "vitest run --no-color --shard=6/10",
		"test:shard:7": "vitest run --no-color --shard=7/10",
		"test:shard:8": "vitest run --no-color --shard=8/10",
		"test:shard:9": "vitest run --no-color --shard=9/10",
		"test:shard:10": "vitest run --no-color --shard=10/10",
		"test:shards": "run-s test:shard:*",
		"dc": "depcruise src/engine src/editor src/bridge src/ui src/page src/@routes src/main.tsx src/createArkiniRouterFx.tsx src/_route.ts server electron electron.vite.config.ts cli test --output-type err-long",
		"jscpd": "jscpd --config jscpd.json",
		"check": "run-s format:check typecheck game:validate build dc jscpd test:shards",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"game:pack": "tsx cli/arkini.ts game pack",
		"game:pack:demo": "tsx cli/arkini.ts game pack-demo",
		"game:pack:official": "tsx cli/arkini.ts arkpack pack-official",
		"game:validate": "tsx cli/arkini.ts game validate",
		"game:schema": "tsx cli/arkini.ts game schema",
		"package:clean": "tsx cli/arkini.ts desktop clean",
		"package:stage": "tsx cli/arkini.ts desktop stage",
		"package:checksums": "tsx cli/arkini.ts desktop checksums",
		"package:verify": "tsx cli/arkini.ts desktop verify",
		"package:mac": "tsx cli/arkini.ts desktop package --arch arm64"
	},
	"dependencies": {
		"@effect/atom-react": "4.0.0-rc.111",
		"@effect/platform-node": "4.0.0-rc.111",
		"@floating-ui/react": "^0.27.20",
		"@logtape/file": "2.3.2",
		"@logtape/logtape": "2.3.2",
		"@modelcontextprotocol/node": "^2.0.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@msgpack/msgpack": "^3.1.3",
		"@paralleldrive/cuid2": "^3.3.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-hotkeys": "^0.10.0",
		"@tanstack/react-router": "1.170.31",
		"cytoscape": "3.34.1",
		"cytoscape-fcose": "2.2.0",
		"effect": "4.0.0-rc.111",
		"fuse.js": "^7.4.2",
		"motion": "^13.1.1",
		"pixi.js": "^8.20.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"ts-pattern": "5.9.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@electron/asar": "4.3.0",
		"@iconify-json/lucide": "1.2.125",
		"@iconify/tailwind4": "1.2.3",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/inspector": "2.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.34",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "6.1.0",
		"dependency-cruiser": "18.2.0",
		"electron": "43.4.1",
		"electron-builder": "26.15.3",
		"electron-vite": "6.0.0-beta.1",
		"jscpd": "5.0.16",
		"jsdom": "30.0.1",
		"npm-run-all2": "9.0.3",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.12",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"main": "./.out/desktop/build/main/index.js",
	"description": "Offline deterministic merge and production game.",
	"author": "Marek Hanzal",
	"engines": {
		"node": "24.19.0",
		"npm": "12.0.2"
	}
}
