{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": [
			"ES2022",
			"DOM"
		],
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"~/*": [
				"./src/*"
			]
		},
		"types": [
			"node",
			"electron"
		],
		"resolveJsonModule": true
	},
	"include": [
		"electron",
		"src/game-tick",
		"src/game-runtime",
		"src/game-persistence",
		"src/item-interaction",
		"src/game-start",
		"src/game-event",
		"src/item-definition",
		"src/item-location",
		"src/item-placement",
		"src/item-merge",
		"src/space-action",
		"src/production-action",
		"src/production-condition",
		"src/production-delivery",
		"src/production-input",
		"src/production-job",
		"src/production-line",
		"src/production-output",
		"src/game-config",
		"src/arkpack/type/ArkpackDescriptor.ts",
		"src/arkpack/artifact",
		"src/asset-authoring/domain",
		"src/editor-build/domain",
		"src/project-authoring/*.ts",
		"src/project-authoring/fn",
		"src/project-authoring/repository/EditorProjectRepository.ts",
		"src/project-authoring/repository/EditorProjectRepositoryError.ts",
		"src/project-authoring/repository/EditorProjectWriteAdmission.ts",
		"src/board-scenario/schema",
		"src/project-version/*.ts",
		"src/project-version/fn",
		"src/project-note/*.ts",
		"src/item-authoring/domain",
		"src/flow/domain",
		"src/estimate/domain",
		"electron.vite.config.ts"
	],
	"exclude": [
		"src/production-job/ui"
	]
}
