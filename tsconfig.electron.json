{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": [
			"ES2022",
			"DOM"
		],
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"~/*": [
				"./src/*"
			]
		},
		"types": [
			"node",
			"electron"
		],
		"resolveJsonModule": true
	},
	"include": [
		"electron",
		"src/game-config",
		"src/arkpack/ArkpackDescriptor.ts",
		"src/arkpack/artifact",
		"src/editor-build/domain",
		"src/editor",
		"src/item-authoring/domain",
		"src/flow/domain",
		"src/estimate/domain",
		"electron.vite.config.ts"
	]
}
