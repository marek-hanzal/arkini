{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2022"
		],
		"jsx": "react-jsx",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"~/*": [
				"./src/*"
			]
		},
		"resolveJsonModule": true,
		"types": [
			"vite/client",
			"node"
		]
	},
	"include": [
		"electron/contract",
		"src/engine",
		"src/game-config",
		"src/arkpack",
		"src/editor-build",
		"src/editor/resource",
		"src/project-authoring",
		"src/board-scenario",
		"src/project-version",
		"src/project-note",
		"src/authoring-mcp",
		"src/authoring-session",
		"src/authoring-shell",
		"src/item-authoring",
		"src/flow",
		"src/estimate",
		"src/renderer",
		"src/ui",
		"src/@routes",
		"src/main.tsx",
		"src/createArkiniRouterFx.tsx",
		"src/_route.ts"
	]
}
